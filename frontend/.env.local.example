# Copy to .env.local for local development.
#
# Server-only (NO NEXT_PUBLIC_ prefix): these are read by the Next.js server-side
# BFF proxy at /bff/[...path] and never shipped to the browser. The bearer token
# stays secret. Leave the token empty when the backend runs with
# POSTMORTEM_DEV_BYPASS=1.
POSTMORTEM_API_ORIGIN=http://localhost:8000
POSTMORTEM_API_TOKEN=dev-token
